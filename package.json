{
  "name": "rproj-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "prepare": "simple-git-hooks || exit 0",
    "check:file-tokens": "bun scripts/check-file-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.3",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "2.0.1",
    "autoprefixer": "10.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "14.10.1",
    "geist": "1.9.2",
    "input-otp": "1.5.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-resizable-panels": "4.20.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/check-file-tokens.mjs ]; then if command -v bun >/dev/null 2>&1; then bun scripts/check-file-tokens.mjs; else node scripts/check-file-tokens.mjs; fi; fi"
  }
}
